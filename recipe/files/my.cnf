# ReadyStack MariaDB configuration, read by mariadbd, mariadb-install-db and the bundled clients.
# Add settings in a .cnf file mounted into /etc/mysql/conf.d/ (read after this file).
[mysqld]
basedir=/usr/local/mariadb
datadir=/var/lib/mysql
socket=/run/mysqld/mysqld.sock
pid-file=/run/mysqld/mysqld.pid
secure-file-priv=/var/lib/mysql-files
skip-name-resolve
host-cache-size=0

[client]
socket=/run/mysqld/mysqld.sock

!includedir /etc/mysql/conf.d/
